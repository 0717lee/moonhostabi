(module
  (type $event (func (param i32)))
  (import "env" "memory" (memory $host_memory 1 3))
  (import "env" "table" (table $host_table 2 4 externref))
  (import "env" "global" (global $host_global (mut i32)))
  (import "env" "tag" (tag $host_tag (type $event)))
  (export "imported_memory" (memory $host_memory))
  (export "imported_table" (table $host_table))
  (export "imported_global" (global $host_global))
  (export "imported_tag" (tag $host_tag))
  (memory (export "memory") 1 3)
  (table (export "table") 2 4 externref)
  (global (export "global") (mut i32) (i32.const 7))
  (tag (export "tag") (type $event))
  (func (export "read_host_global") (result i32) (global.get $host_global))
  (func (export "write_host_global") (param i32) (global.set $host_global (local.get 0)))
  (func (export "read_host_memory") (param i32) (result i32) (i32.load8_u (local.get 0)))
  (func (export "write_host_memory") (param i32 i32) (i32.store8 (local.get 0) (local.get 1)))
  (func $start (global.set $host_global (i32.const 666)))
  (start $start)
)
